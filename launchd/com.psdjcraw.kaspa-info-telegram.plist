<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.psdjcraw.kaspa-info-telegram</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/psdjc/.openclaw/workspace/telegram-kaspa-ticker &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; exec /usr/bin/env PYTHONUNBUFFERED=1 python3 ticker_bot.py</string>
  </array>
